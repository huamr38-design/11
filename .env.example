# 你的密钥只放服务器环境变量，不要写进前端页面。
AI_API_KEY=你的_API_Key

# OpenAI 兼容接口地址。用 Grok/xAI 时通常是：
# AI_BASE_URL=https://api.x.ai/v1
# 其它中转站也填它给你的 /v1 地址。
AI_BASE_URL=https://api.openai.com/v1

# 填你要用的模型名，例如 grok-4、gpt-4.1、或中转站里的模型 id。
AI_MODEL=gpt-4.1-mini

# chat = /chat/completions
# responses = /responses
AI_WIRE_API=chat

# 0.7 稳一点，0.9 更会演。
AI_TEMPERATURE=0.85

# 管理员修改前台/后台智能体时使用
ADMIN_PASSWORD=admin123
